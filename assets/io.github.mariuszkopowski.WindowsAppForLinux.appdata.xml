<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.mariuszkopowski.WindowsAppForLinux</id>
  <name>Windows App</name>
  <summary>Windows App (cloud.microsoft) client for Linux</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>
      Windows App for Linux is an unofficial Electron wrapper for
      windows.cloud.microsoft, allowing Linux users to connect to
      Azure Virtual Desktop and Windows 365 cloud PCs without a
      native Windows client.
    </p>
    <p>Features:</p>
    <ul>
      <li>Connects to Windows App portal and launches AVD sessions</li>
      <li>Each session opens in a separate window with fullscreen support</li>
      <li>Edge on Windows user-agent spoofing for full compatibility</li>
      <li>System tray integration with quick access to open sessions</li>
      <li>Hardware video decode support (VAAPI on Intel/AMD)</li>
      <li>Wayland and X11 support</li>
    </ul>
  </description>

  <url type="homepage">https://github.com/mariuszkopowski/windows-app-for-linux</url>
  <url type="bugtracker">https://github.com/mariuszkopowski/windows-app-for-linux/issues</url>

