{
  "name": "windows-app-for-linux",
  "version": "0.1.0",
  "description": "Windows App (windows.cloud.microsoft) wrapper for Linux",
  "main": "app/index.js",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "test:watch": "jest --watch",
    "build:appimage": "electron-builder --linux AppImage",
    "build:flatpak": "electron-builder --linux flatpak",
    "build": "electron-builder --linux AppImage flatpak"
  },
  "keywords": [
    "electron",
    "windows-app",
    "azure-virtual-desktop",
    "linux"
  ],
  "author": "mkoprowski",
  "license": "GPL-3.0",
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "jest": "^30.4.2"
  },
  "dependencies": {
    "yargs": "^17.7.2"
  },
  "build": {
    "appId": "io.github.mkoprowski.WindowsAppForLinux",
    "productName": "Windows App",
    "files": [
      "app/**/*",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "flatpak"
      ],
      "category": "Network;Office",
      "icon": "assets/icons",
      "maintainer": "mkoprowski"
    },
    "appImage": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "flatpak": {
      "runtimeVersion": "24.08",
      "baseVersion": "24.08",
      "branch": "stable",
      "useWaylandFlags": true,
      "finishArgs": [
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--socket=session-bus",
        "--device=dri",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.freedesktop.portal.Desktop",
        "--talk-name=org.freedesktop.ScreenSaver",
        "--filesystem=xdg-download"
      ]
    }
  },
  "allowScripts": {
    "electron@34.5.8": true
  }
}
